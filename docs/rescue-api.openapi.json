  "components": {
    "schemas": {
      "RescueRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wallet"
        ],
        "properties": {
          "wallet": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty test-wallet label; a real Ethereum address is not required for Mock."
          }
        }
      },
      "AssetBalance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "amount",
          "usdValue",
          "category"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "tokenAddress": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "usdValue": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "enum": [
              "RISK",
              "DEFENSIVE"
            ]
          }
        }
      },
      "PortfolioState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wallet",
          "totalUsd",
          "riskAssetUsd",
          "defensiveAssetUsd",
          "riskExposurePct",
          "assets",
          "timestamp"
        ],
        "properties": {
          "wallet": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty test-wallet label; a real Ethereum address is not required for Mock."
          },
          "totalUsd": {
            "type": "number",
            "minimum": 0
          },
          "riskAssetUsd": {
            "type": "number",
            "minimum": 0
          },
          "defensiveAssetUsd": {
            "type": "number",
            "minimum": 0
          },
          "riskExposurePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetBalance"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp."
          },
          "blockNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "description": "Asset symbols are unique; category totals and riskExposurePct agree with balances. totalUsd=0 implies riskExposurePct=0. Zero token amount cannot carry positive usdValue. Runtime Zod checks use relative tolerance 1e-9.",
        "x-runtime-invariants": [
          "unique assets.symbol",
          "category asset totals equal aggregate totals",
          "riskExposurePct = totalUsd == 0 ? 0 : riskAssetUsd/totalUsd*100"
        ]
      },
      "MarketState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "priceUsd",
          "priceChange5mPct",
          "priceChange1hPct",
          "volatilityScore",
          "timestamp"
        ],
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "priceUsd": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": 0
          },
          "priceChange5mPct": {
            "type": "number",
            "minimum": -100
          },
          "priceChange1hPct": {
            "type": "number",
            "minimum": -100
          },
          "volatilityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp."
          }
        },
        "description": "Independent Mock market quote, never fields hidden inside PortfolioState."
      },
      "StressTestResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priceChangePct",
          "projectedPortfolioUsd",
          "projectedLossUsd"
        ],
        "properties": {
          "priceChangePct": {
            "type": "number",
            "minimum": -100
          },
          "projectedPortfolioUsd": {
            "type": "number",
            "minimum": 0
          },
          "projectedLossUsd": {
            "type": "number",
            "minimum": 0
          }
        },
        "description": "Scenario applied to before snapshot RISK USD values with defensive valuation fixed; not a second shock from current market price."
      },
      "InvestigationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "primaryCause",
          "evidence",
          "uncertainties",
          "confidence"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "primaryCause": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "RiskAnalysis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riskScore",
          "confidence",
          "riskExposurePct",
          "stressTests",
          "investigation",
          "recommendedAction"
        ],
        "properties": {
          "riskScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "riskExposurePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stressTests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StressTestResult"
            }
          },
          "investigation": {
            "$ref": "#/components/schemas/InvestigationResult"
          },
          "recommendedAction": {
            "type": "string",
            "enum": [
              "NONE",
              "SWAP_TO_SAFE"
            ]
          }
        },
        "description": "recommendedAction and prose are advisory; only Policy approves execution. Final session confidence equals investigation.confidence."
      },
      "PolicyConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minRiskScore",
          "minConfidence",
          "minRiskExposurePct",
          "maxDeRiskPct",
          "allowedRiskAssets",
          "allowedDefensiveAssets"
        ],
        "properties": {
          "minRiskScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minRiskExposurePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "maxDeRiskPct": {
            "type": "number",
            "minimum": 0,
            "description": "Percentage points of total portfolio risk exposure, not a fraction of the risk balance. Reducing 80% by 30 points means 50%.",
            "maximum": 100
          },
          "allowedRiskAssets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Trimmed nonempty asset symbol."
            }
          },
          "allowedDefensiveAssets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Trimmed nonempty asset symbol."
            }
          }
        },
        "description": "Trusted server-side user preset; not accepted in the API request. Allowlists are unique and disjoint. USDC is user-approved defensive, not risk-free.",
        "example": {
          "minRiskScore": 80,
          "minConfidence": 0.85,
          "minRiskExposurePct": 70,
          "maxDeRiskPct": 30,
          "allowedRiskAssets": [
            "ETH"
          ],
          "allowedDefensiveAssets": [
            "USDC"
          ]
        }
      },
      "PolicyDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "triggered",
          "action",
          "reasons"
        ],
        "properties": {
          "triggered": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "NONE",
              "SWAP_TO_SAFE"
            ]
          },
          "sourceAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "targetAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "reduceExposurePct": {
            "type": "number",
            "minimum": 0,
            "description": "Percentage points of total portfolio risk exposure, not a fraction of the risk balance. Reducing 80% by 30 points means 50%.",
            "maximum": 100
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "triggered": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "sourceAsset",
                "targetAsset",
                "reduceExposurePct"
              ],
              "properties": {
                "action": {
                  "const": "SWAP_TO_SAFE"
                },
                "reduceExposurePct": {
                  "exclusiveMinimum": 0
                }
              }
            },
            "else": {
              "properties": {
                "action": {
                  "const": "NONE"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sourceAsset"
                    ]
                  },
                  {
                    "required": [
                      "targetAsset"
                    ]
                  },
                  {
                    "required": [
                      "reduceExposurePct"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "description": "Triggered decisions require distinct source/target assets; the configured RISK -> user-approved DEFENSIVE direction, limits and allowlists are independently checked by Policy and Executor. Schema acceptance is not transaction permission."
      },
      "SkippedExecution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "action",
          "timestamp"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "action": {
            "const": "NONE"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp."
          }
        }
      },
      "SuccessfulSwapExecution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "action",
          "sourceAsset",
          "targetAsset",
          "sourceAmount",
          "targetAmount",
          "txHash",
          "timestamp"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "action": {
            "const": "SWAP_TO_SAFE"
          },
          "sourceAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "targetAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "sourceAmount": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": 0
          },
          "targetAmount": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": 0
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp."
          }
        },
        "description": "Distinct source/target assets; Mock txHash is fabricated and must be clearly labeled. This receipt does not prove mitigation."
      },
      "FailedSwapExecution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "action",
          "sourceAsset",
          "targetAsset",
          "timestamp",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "action": {
            "const": "SWAP_TO_SAFE"
          },
          "sourceAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "targetAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed nonempty asset symbol."
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601 timestamp."
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "No settled amounts are claimed on failure; source/target remain the approved distinct assets. Optional hash is allowed by the runtime contract; Mock failures do not fabricate it."
      },
      "ExecutionResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SkippedExecution"
          },
          {
            "$ref": "#/components/schemas/SuccessfulSwapExecution"
          },
          {
            "$ref": "#/components/schemas/FailedSwapExecution"
          }
        ]
      },
      "VerificationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reasons"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SKIPPED",
              "PASSED",
              "FAILED"
            ]
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "description": "SKIPPED: unapproved or unsuccessful execution, no after. PASSED: receipt plus independent re-read and all checks pass. FAILED: successful execution and real re-read, but effect/evidence does not pass; stop without another trade."
      },
      "RescueSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "market",
          "riskAnalysis",
          "policyDecision",
          "execution",
          "verification"
        ],
        "properties": {
          "before": {
            "$ref": "#/components/schemas/PortfolioState"
          },
          "market": {
            "$ref": "#/components/schemas/MarketState"
          },
          "riskAnalysis": {
            "$ref": "#/components/schemas/RiskAnalysis"
          },
          "policyDecision": {
            "$ref": "#/components/schemas/PolicyDecision"
          },
          "execution": {
            "$ref": "#/components/schemas/ExecutionResult"
          },
          "after": {
            "$ref": "#/components/schemas/PortfolioState"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationResult"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "execution": {
                  "properties": {
                    "success": {
                      "const": true
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "after"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "after"
                ]
              }
            }
          }
        ],
        "description": "Execution action/assets match Policy. Analysis exposure matches before; confidence matches investigation. Success always requires an independent after. Runtime verification checks wallet, timestamps/blocks, asset identity/direction, approved percentage points at the market quote, receipt balance changes, unaffected assets and lower exposure; status is recomputed by Zod.",
        "x-runtime-invariants": [
          "execution action/source/target match policyDecision",
          "execution.success iff after exists",
          "after.wallet == before.wallet",
          "riskAnalysis.riskExposurePct matches before",
          "riskAnalysis.confidence == investigation.confidence",
          "verification.status equals verifyRescueOutcome(before,after,decision,execution,market).status"
        ]
      },
      "RescueProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^urn:xjy:rescue:(INVALID_REQUEST|RESCUE_FAILED)$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "enum": [
              400,
              500
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "instance": {
            "const": "/api/rescue"
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "RESCUE_FAILED"
            ]
          }
        },
        "description": "Problem response. INVALID_REQUEST=400, RESCUE_FAILED=500. Raw exception text, endpoint URLs, credentials and stacks are never returned."
      }
    }
  }
}
