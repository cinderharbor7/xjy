{
  "openapi": "3.1.0",
  "info": {
    "title": "Guardian Mock Rescue API",
    "version": "0.1.0",
    "description": "Autonomous On-chain Risk Guardian Mock flow. Existing /api/rescue URL is retained, but its former lending/HF/REPAY response is intentionally replaced by Portfolio/Market/SWAP_TO_SAFE and verification. No legacy response shim, real DEX, wallet, LLM or transaction. Only RISK -> user-approved DEFENSIVE is permitted; defensive -> risk and re-entry are forbidden."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [],
  "paths": {
    "/api/rescue": {
      "post": {
        "operationId": "runMockGuardianRescue",
        "summary": "Run one independently scoped Guardian Mock rescue session",
        "description": "Strict {wallet} request, no policy/asset/action/RPC overrides. Every call creates fresh Mock balances and market state, with no persistent idempotency, database or shared wallet updates. Core needs no API Key/RPC and accepts any trimmed nonempty wallet label. No pagination/multichain/wallet signing or retries. Orchestrator reads Portfolio, Market, analyzes/investigates, evaluates Policy, executes only if approved, then independently re-reads and verifies. MOCK_MODE=false explicitly fails. Aave live-read extension is separate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RescueRequest"
              },
              "example": {
                "wallet": "test-wallet"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New Guardian RescueSession. A successful swap still requires independent verification; FAILED is a reported outcome, not a second trade.",
            "headers": {
              "Cache-Control": {
                "description": "Uncached result.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Rescue-Mode": {
                "description": "All core external capabilities are Mock.",
                "schema": {
                  "type": "string",
                  "const": "MOCK"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RescueSession"
                },
                "examples": {
                  "passed": {
                    "summary": "Fixed Mock 10 ETH -> 7 ETH + 8100 USDC, 100% -> 70%. Market decline explains $30000 -> $27000.",
