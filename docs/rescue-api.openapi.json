                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RescueProblem"
                },
                "example": {
                  "type": "urn:xjy:rescue:INVALID_REQUEST",
                  "title": "Invalid rescue request",
                  "status": 400,
                  "detail": "Expected { wallet: string } with a nonempty test wallet and no extra fields.",
                  "instance": "/api/rescue",
                  "code": "INVALID_REQUEST"
                }
              }
            }
