# Default: fixed-wallet persistent Mock monitor; never enables Fork implicitly.
MOCK_MODE=true
GUARDIAN_MODE=MOCK
GUARDIAN_WALLET=0x1111111111111111111111111111111111111111
GUARDIAN_DB_PATH=.guardian/state.sqlite
GUARDIAN_ORIGIN=http://localhost:3000
# Optional local JSON demo signals; timestamps are validated, not refreshed on read.
GUARDIAN_SIGNAL_FILE=

# Explicit local Fork only: set GUARDIAN_MODE=FORK and matching disposable wallet/key.
# Native ETH is gas; logical ETH in the portfolio is the WETH ERC20 balance.
FORK_RPC_URL=http://127.0.0.1:8545
FORK_PRIVATE_KEY=

# Optional read-only Aave extension at /position, separate from the main Demo.
# RPC must support historical eth_call and EIP-1898 blockHash + requireCanonical.
ETHEREUM_RPC_URL=
AAVE_NETWORK=ethereum-mainnet

# Reserved for future adapters; never commit private keys or API keys.
LLM_API_KEY=
PRIVATE_KEY=
