# Default: fixed-wallet persistent Mock monitor; never enables Fork implicitly.
MOCK_MODE=true
GUARDIAN_MODE=MOCK
GUARDIAN_WALLET=0x1111111111111111111111111111111111111111
GUARDIAN_DB_PATH=.guardian/state.sqlite
GUARDIAN_ORIGIN=http://localhost:3000
# Optional local JSON demo signals; timestamps are validated, not refreshed on read.
GUARDIAN_SIGNAL_FILE=

# Explicit local Fork only: set GUARDIAN_MODE=FORK and matching disposable wallet/key.
# Native ETH is gas; logical ETH in the portfolio is the WETH ERC20 balance.
# Start Anvil with --block-time 2 so verifiable block timestamps remain fresh.
# Portfolio/quote share a canonical block; historical changes/investigation are Demo inputs.
FORK_RPC_URL=http://127.0.0.1:8545
FORK_PRIVATE_KEY=

# Live /investigate transaction checks, Developer A CLI, and Aave /position extension.
# Mainnet RPC: EIP-1898 blockHash + requireCanonical for eth_call/getBalance,
# recent 1h history, eth_getLogs and eth_getTransactionByHash for A's CLI.
# Aave additionally needs historical eth_call over the preceding 7200 blocks.
# Transaction checks need tx/receipt/block reads and historical pool/ERC20 eth_call
# at the transaction's blockHash (requireCanonical); no signing key is needed.
ETHEREUM_RPC_URL=
AAVE_NETWORK=ethereum-mainnet

# Explicit AI adapter configuration (not auto-enabled); never commit keys.
LLM_API_KEY=
# Optional: an OpenAI-compatible chat completions endpoint.
LLM_API_URL=
# Optional: model identifier. Defaults to gpt-4o-mini.
LLM_MODEL=
PRIVATE_KEY=

# BOT Chain report attestation: PUBLIC config only. All signing is done in MetaMask.
# Chain ID 968, gas BOT, explorer https://scan.bohr.life
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.bohr.life
# Deploy from /attestations with MetaMask; paste the confirmed registry address here.
# Rebuild/restart after changing NEXT_PUBLIC_* variables. Empty enables browser setup.
NEXT_PUBLIC_BOT_REPORT_REGISTRY=
