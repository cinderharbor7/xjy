# Main Guardian Demo uses Mock adapters only and requires no RPC or API keys.
MOCK_MODE=true

# Developer A read-only CLI (pnpm data:read) and optional Aave /position extension.
# Mainnet RPC: EIP-1898 blockHash + requireCanonical for eth_call/getBalance,
# recent 1h history, eth_getLogs and eth_getTransactionByHash for A's CLI.
# Aave additionally needs historical eth_call over the preceding 7200 blocks.
ETHEREUM_RPC_URL=
AAVE_NETWORK=ethereum-mainnet

# Reserved for future adapters; never commit private keys or API keys.
LLM_API_KEY=
PRIVATE_KEY=
